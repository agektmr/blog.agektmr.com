---
layout: layouts/base
templateClass: tmpl-post
---
<div class="post">

<div class="post-header-container has-cover" {% if image.feature %}style="background-image: url({{ site.imagepath }}{{ image.feature }});"{% else %}style="background-image: url({{ site.cover }});"{% endif %}>
  <div class="scrim has-cover">
    <header class="post-header">
      <h1 class="title">{{ title }}</h1>
      <p class="info">by<strong> {% if not author %}{{ site.owner.name }}{% else %}{{ author }}{% endif %}</strong></p>
    </header>
  </div>
</div>

<div class="wrapper">

<section class="post-meta">
  <div class="meta-badges">
    <span class="meta-pill date-pill"><i class="far fa-calendar-alt"></i> {{ page.date | localeDateString(lang or 'en') }}</span>
    {% if updated %}
    <span class="meta-pill update-pill"><i class="fas fa-redo"></i> {% if lang == 'ja' %}更新{% else %}Updated{% endif %}: {{ updated | localeDateString(lang or 'en') }}</span>
    {% endif %}
    {% set organicVal = organic if organic is defined else 100 %}
    <span class="meta-pill organic-pill" title="{% if lang == 'ja' %}AIを使わずに書いた度合い{% else %}Ratio written without AI{% endif %}">
      <i class="fas fa-seedling"></i> {{ organicVal }}% Organic
    </span>
    {% set altLang = 'en' if lang == 'ja' else 'ja' %}
    {% set readInAltLang = 'Read in English' if lang == 'ja' else '日本語で読む' %}
    {% set altPostUrl = page.url | replace('/' + lang + '/', '/' + altLang + '/') %}
    {% if altPostUrl %}
    <a href="{{ altPostUrl }}" class="meta-pill lang-pill"><i class="fas fa-globe"></i> {{ readInAltLang }}</a>
    {% endif %}
  </div>
</section>

<article class="post-content">
  {{ content | safe }}
</article>

<section class="share">
  <span class="share-label">Share:</span>
  <div class="share-buttons">
  {% set full_url %}{{ site.baseurl }}{{ page.url }}{% endset %}
  {% for social in site.social %}
    {% if social.name == "X" and social.share == true %}
      <a href="//x.com/share?text={{ title | urlencode }} - {{ site.name | urlencode }}&url={{ full_url | urlencode}}&via={{social.username}}"
        class="share-btn share-x" title="Share on X"
        onclick="window.open(this.href, '{{ social.icon }}-share', 'width=550,height=550');return false;">
        <i class="fab fa-{{ social.icon }}"></i>
      </a>
    {% endif %}
    {% if social.name == "Bluesky" and social.share == true %}
      <a href="//bsky.app/intent/compose?text={{ title | urlencode}}+{{full_url | urlencode}}"
        class="share-btn share-bsky" title="Share on Bluesky"
        onclick="window.open(this.href, '{{ social.icon }}-share', 'width=550,height=550');return false;">
        <i class="fab fa-{{ social.icon }}"></i>
      </a>
    {% endif %}
    {% if social.name == "LinkedIn" and social.share == true %}
      <a href="//www.linkedin.com/shareArticle?mini=true&url={{ full_url | urlencode}}"
        class="share-btn share-linkedin" title="Share on LinkedIn"
        onclick="window.open(this.href, '{{ social.icon }}-share', 'width=550,height=550');return false;">
        <i class="fab fa-{{ social.icon }}"></i>
      </a>
    {% endif %}
  {% endfor %}
  </div>
</section>
</div>
</div>
