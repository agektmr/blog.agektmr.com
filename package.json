{
  "name": "blog-agektmr-com",
  "version": "2.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "eleventy && sass src/styles/main.scss _site/styles/style.css --no-source-map && rollup -c rollup.config.mjs",
    "watch": "eleventy --watch",
    "start": "eleventy --serve",
    "start:server": "node server/index.js",
    "debug": "DEBUG=* eleventy",
    "translate": "node scripts/translate.js",
    "translate:build": "pnpm run translate && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/agektmr/blog.agektmr.com.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/agektmr/blog.agektmr.com/issues"
  },
  "homepage": "https://github.com/agektmr/blog.agektmr.com#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@google-cloud/translate": "^10.1.1",
    "@google/genai": "^2.27.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eleventy-plugin-excerpt": "^1.1.2",
    "eleventy-plugin-i18n": "^0.1.3",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "only-allow": "^1.2.2",
    "prismjs": "^1.30.0",
    "rollup": "^4.64.0",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.105.1",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-spacing": "^3.0.3"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1"
  },
  "overrides": {
    "semver": "^7.5.2",
    "bl": "^4.0.3"
  }
}